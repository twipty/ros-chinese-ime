// RosPinyin - Simplified Chinese pinyin IME for ReactOS
// SPDX-License-Identifier: MIT
// See LICENSE and NOTICE.txt at the repository root.
//
// WBS 2.2.3: version resource must satisfy ImmLoadLayout checks:
//   FILETYPE    = VFT_DRV             (0x3)
//   FILESUBTYPE = VFT2_DRV_INPUTMETHOD(0xB)
//   Translation = 0x0804 / 1200      (zh-CN / Unicode)
// The layout display name is resource ID 1024 so the keyboard layout can
// reference it without duplicating the translated string in the registry.

#include "resource.h"
#include <windows.h>
// MSVC rc.exe needs the pragma; GNU windres rejects it and instead receives
// the codepage from CMake ("-c 65001", see the root CMakeLists.txt).
#ifdef _MSC_VER
#pragma code_page(65001) // UTF-8
#endif

// Tray icon for the ReactOS language bar (kbswitch). See IDI_ROSPINYIN in
// resource.h: for an IME layout kbswitch extracts the first RT_GROUP_ICON
// from this module instead of drawing a [CH] abbreviation. Without this
// icon the tray shows no layout badge at all.
IDI_ROSPINYIN ICON "rospinyin.ico"

// Which "keyboard" the layout lands under is decided **solely** by the first
// entry of VarFileInfo\Translation in this resource: imm32_install.c does
// `pInfoEx->hkl = UlongToHandle(*pw)`, so the low word of the HKL (hence
// E0xx0804 vs E0xx0409) comes from here. The Japanese IME that ships with the
// system uses 0409; ours used 0804, which made every A/B comparison differ
// in two variables at once (IME implementation + layout language/charset).
// Build with -DROSPINYIN_IME_LANGID=0409 to get a control build that sits in
// the exact same language slot as the system IME.
#ifdef ROSPINYIN_IME_LANG_EN
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#define ROSPINYIN_STRBLOCK "040904b0"
#define ROSPINYIN_TRANSLATION_LANGID 0x409
#else
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#define ROSPINYIN_STRBLOCK "080404b0"
#define ROSPINYIN_TRANSLATION_LANGID 0x804
#endif

1 VERSIONINFO
FILEVERSION     0, 0, 1, 0
PRODUCTVERSION  0, 0, 1, 0
FILEFLAGSMASK   0x3fL
FILEOS          0x40004L
FILETYPE        0x3L
FILESUBTYPE     0xBL
{
    BLOCK "StringFileInfo"
    {
        BLOCK ROSPINYIN_STRBLOCK
        {
            VALUE "CompanyName",      "RosPinyin contributors\0"
            VALUE "FileDescription", "中文(简体) - RosPinyin\0"
            VALUE "FileVersion",     "alpha0.0.1\0"
            VALUE "InternalName",    "rospinyin\0"
            VALUE "LegalCopyright",  "Copyright (c) 2026 RosPinyin contributors. MIT.\0"
            VALUE "OriginalFilename", "rospinyin.ime\0"
            VALUE "ProductName",     "RosPinyin\0"
            VALUE "ProductVersion",  "alpha0.0.1\0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", ROSPINYIN_TRANSLATION_LANGID, 1200
    }
}

STRINGTABLE
{
    IDS_LAYOUT_TEXT, "中文(简体) - RosPinyin"
    IDS_IME_NAME,    "RosPinyin 拼音输入法"
}

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_LAYOUT_TEXT, "Chinese (Simplified) - RosPinyin"
    IDS_IME_NAME,    "RosPinyin Pinyin IME"
}
