// See LICENSE and NOTICE.txt at the repository root.
//
// GUI-installer-only RCDATA. Keeping these blobs out of ime/rospinyin_res.rc
// preserves the frozen rospinyin.ime hash and size; the resource compiler
// reads the escaped byte-string macros generated into payload_base64.hpp.
// Bare `0xHH` byte lists are NOT used here: windres stores each item as a
// 16-bit word, which doubled the payload and made SizeofResource() disagree
// with the expected compressed size (guest error 6).

#define ROSPINYIN_RC_PAYLOAD_ONLY
#include "payload_base64.hpp"

ROSPINYIN_IDR_IME_PAYLOAD RCDATA
{
    ROSPINYIN_IME_PAYLOAD_RC_BYTES
}

ROSPINYIN_IDR_DAT_PAYLOAD RCDATA
{
    ROSPINYIN_DAT_PAYLOAD_RC_BYTES
}

ROSPINYIN_IDR_CLI_PAYLOAD RCDATA
{
    ROSPINYIN_CLI_PAYLOAD_RC_BYTES
}

// M4: the word list travels inside the same single EXE. Resource id 104
// keeps the first three blobs (and the frozen rospinyin.ime hash) untouched.
// It is split into ROSPINYIN_LEX_RCDATA_SEGMENTS consecutive RCDATA blobs:
// one giant RCDATA (116,814 adjacent string literals) makes windres's O(n^2)
// concatenation hang for >11 min; 8 segments compile in ~14 s. The GUI loads
// them in ID order (104..111) and concatenates before inflate.
ROSPINYIN_IDR_LEX_PAYLOAD RCDATA
{
    ROSPINYIN_LEX_PAYLOAD_RC_BYTES_0
}
105 RCDATA { ROSPINYIN_LEX_PAYLOAD_RC_BYTES_1 }
106 RCDATA { ROSPINYIN_LEX_PAYLOAD_RC_BYTES_2 }
107 RCDATA { ROSPINYIN_LEX_PAYLOAD_RC_BYTES_3 }
108 RCDATA { ROSPINYIN_LEX_PAYLOAD_RC_BYTES_4 }
109 RCDATA { ROSPINYIN_LEX_PAYLOAD_RC_BYTES_5 }
110 RCDATA { ROSPINYIN_LEX_PAYLOAD_RC_BYTES_6 }
111 RCDATA { ROSPINYIN_LEX_PAYLOAD_RC_BYTES_7 }

// UI whats-new text (alpha0.1.2 update points). Separate from the four
// compressed payloads: uncompressed UTF-8 bytes, loaded as a string by the
// GUI. Regenerate via pack_payload.py --whatsnew after editing whatsnew.txt.
ROSPINYIN_IDR_WHATSNEW RCDATA
{
    ROSPINYIN_WHATSNEW_RC_BYTES
}

// AC3: license viewer reads these from the EXE itself (no side-car files).
ROSPINYIN_IDR_LICENSE RCDATA
{
    ROSPINYIN_LICENSE_RC_BYTES
}
ROSPINYIN_IDR_NOTICE RCDATA
{
    ROSPINYIN_NOTICE_RC_BYTES
}
